{
  "name": "hebros-mcp",
  "version": "0.4.0",
  "type": "module",
  "description": "Token-cheap codebase maps for AI coding agents. MCP server: tree-sitter symbols with exact line numbers, import graph, call edges. Navigate code without read/grep loops.",
  "bin": {
    "hebros": "bin/hebros.js",
    "hebros-mcp": "bin/hebros.js"
  },
  "files": [
    "bin",
    "dist/src",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node dist/scripts/smoke.js",
    "index": "node bin/hebros.js index",
    "serve": "node bin/hebros.js serve",
    "test": "tsc -p . && node --no-maglev --test dist/scripts/test/*.test.js",
    "bench": "node dist/scripts/bench.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "web-tree-sitter": "^0.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "DeVladinci (https://github.com/DeVladinci)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devladinci/hebros-mcp.git"
  },
  "homepage": "https://github.com/devladinci/hebros-mcp#readme",
  "bugs": {
    "url": "https://github.com/devladinci/hebros-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "tree-sitter",
    "llm",
    "ai-agents",
    "code-index",
    "typescript"
  ]
}
